{
  "name": "jscpp-ng",
  "version": "3.0.0",
  "description": "A simple C++ interpreter written in JavaScript",
  "keywords": [
    "c++",
    "cpp",
    "interpreter",
    "c"
  ],
  "homepage": "https://github.com/rauba-code/JSCPP-NG",
  "bugs": {
    "url": "https://github.com/rauba-code/JSCPP/issues"
  },
  "authors": [
    "Felix Hao <felixhao28@gmail.com>",
    "Tomas Blazauskas <>",
    "Arnoldas Rauba <raubarno@noreply.codeberg.org>"
  ],
  "maintainers": [
    "Arnoldas Rauba <raubarno@noreply.codeberg.org>"
  ],
  "contributors": [
    "Felix Hao <felixhao28@gmail.com>",
    "Tomas Blazauskas <>",
    "Arnoldas Rauba <raubarno@noreply.codeberg.org>"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "node build_pegjs.js",
    "build": "npx webpack",
    "debugger-test": "mocha --require ts-node/register unit-tests/test-debugger.ts --bail",
    "unit-test": "mocha --require ts-node/register unit-tests/test.ts --bail",
    "integration-test": "mocha --require ts-node/register integration-tests/test.ts --bail",
    "test": "npx concurrently 'npm:*-test'"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "include": [
      "src"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text"
    ],
    "all": true
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "js-yaml": "^5.5.0",
    "mocha": "^12.0.3",
    "peggy": "^5.1.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixhao28/JSCPP.git"
  },
  "license": "MIT",
  "directories": {
    "test": "test"
  }
}
